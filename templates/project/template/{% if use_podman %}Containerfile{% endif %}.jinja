{% if language == "python" %}
FROM docker.io/library/python:3.13-slim
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev
CMD ["uv", "run", "python", "-m", "{{ project_slug | replace('-', '_') }}"]
{% elif language == "node" %}
FROM docker.io/library/node:lts-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
CMD ["node", "."]
{% elif language == "rust" %}
FROM docker.io/library/rust:1 AS build
WORKDIR /src
COPY . .
RUN cargo build --release

FROM docker.io/library/debian:bookworm-slim
COPY --from=build /src/target/release/{{ project_slug }} /usr/local/bin/{{ project_slug }}
CMD ["{{ project_slug }}"]
{% elif language == "go" %}
FROM docker.io/library/golang:1 AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/{{ project_slug }} .

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/{{ project_slug }} /{{ project_slug }}
ENTRYPOINT ["/{{ project_slug }}"]
{% elif language == "dotnet" %}
# One image per deployable project under src/:
#   podman build --build-arg PROJECT=MyApp.Web -t myapp-web .
ARG PROJECT

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG PROJECT
RUN test -n "$PROJECT" || { echo "pass --build-arg PROJECT=<name of the project under src/>"; exit 1; }
WORKDIR /src
COPY . .
RUN dotnet publish "src/$PROJECT" -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ARG PROJECT
ENV APP_DLL="$PROJECT.dll"
WORKDIR /app
COPY --from=build /out .
# The aspnet image ships the non-root `app` user (APP_UID) but starts as root.
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec dotnet \"$APP_DLL\" \"$@\"", "--"]
{% else %}
FROM docker.io/library/alpine:3
WORKDIR /app
COPY . .
CMD ["sh"]
{% endif %}
